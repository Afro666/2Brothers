# Every value in {$...} comes from the server's .env through deploy/compose.yaml.
# SITE_ADDRESS: a host name gets HTTPS automatically; ":80" or "http://<ip>" stays plain HTTP.
{
	order rate_limit before reverse_proxy
}

# While the gateway restarts after a deploy, a request waits for it instead of failing.
# Caddy retries only when it could not connect, so nothing already sent is sent twice
# (after a connection, it retries GET only: the default lb_retry_match).
(wait_for_gateway) {
	lb_try_duration 15s
	lb_try_interval 500ms
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Sent with every answer. HSTS only counts over HTTPS; a browser ignores it on plain HTTP.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Health check for monitors: no password, and it says nothing but "ok".
	handle /api/ping {
		rewrite * /health
		reverse_proxy gateway:8000 {
			import wait_for_gateway
		}
	}

	# The Buyer agent and other services call the gateway here with their own
	# bearer token; the gateway checks it. No shared password on this path.
	handle_path /gateway/* {
		# The same caps as /api below (#1322): the open demo lets a visitor make a token, and
		# with it these routes run the paid models too. The Buyer service is not counted: it
		# calls the gateway inside the Docker network, not through this path.
		rate_limit {
			zone gateway_new_proposals {
				match {
					method POST
					path_regexp ^/v1/kitchens/[^/]+/proposals$
				}
				key {remote_host}
				events 10
				window 1m
			}
			zone gateway_shelf_photos {
				match {
					method POST
					path_regexp ^/v1/kitchens/[^/]+/stock/photo$
				}
				key {remote_host}
				events 10
				window 1m
			}
			zone gateway_writes {
				match {
					method POST PUT PATCH DELETE
				}
				key {remote_host}
				events 60
				window 1m
			}
		}
		reverse_proxy gateway:8000 {
			import wait_for_gateway
		}
	}

	# No password on the screens (Tymon, 2026-11-14): anyone with the link can use
	# the demo, including approving its orders.
	# The gateway's human token is added here, on the server, so it never
	# reaches a browser. The web app says who is acting in X-User.
	handle_path /api/* {
		@anonymous not header X-User *
		request_header @anonymous X-User demo-visitor

		# The path is open, and a new proposal runs the paid Buyer model: cap
		# writes per visitor address. Over the cap the answer is 429.
		rate_limit {
			zone new_proposals {
				match {
					method POST
					path_regexp ^/v1/kitchens/[^/]+/proposals$
				}
				key {remote_host}
				events 10
				window 1m
			}
			# A shelf photo runs the paid vision model (#373): the same cap as a proposal.
			zone shelf_photos {
				match {
					method POST
					path_regexp ^/v1/kitchens/[^/]+/stock/photo$
				}
				key {remote_host}
				events 10
				window 1m
			}
			zone writes {
				match {
					method POST PUT PATCH DELETE
				}
				key {remote_host}
				events 60
				window 1m
			}
		}
		reverse_proxy gateway:8000 {
			import wait_for_gateway
			header_up Authorization "Bearer {$GATEWAY_HUMAN_TOKEN}"
		}
	}

	# Agent discovery (#293): the gateway writes both files from its own routes.
	# Public, read-only, no token; the same files are at /gateway/llms.txt.
	handle /llms.txt {
		reverse_proxy gateway:8000 {
			import wait_for_gateway
		}
	}
	handle /.well-known/agent-card.json {
		reverse_proxy gateway:8000 {
			import wait_for_gateway
		}
	}

	handle {
		root * /srv
		# Vite puts a content hash in every file name under /assets: a browser may keep them for
		# good. index.html names the current files, so it is asked for again on every visit.
		# Only a file that exists: a missing one falls through to index.html below and must not be kept.
		@hashed {
			path /assets/*
			file
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		# The web app routes in the browser: unknown paths get index.html.
		try_files {path} /index.html
		file_server
	}
}
