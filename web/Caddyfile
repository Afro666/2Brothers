# Every value in {$...} comes from the server's .env through deploy/compose.yaml.
# SITE_ADDRESS: a host name gets HTTPS automatically; ":80" or "http://<ip>" stays plain HTTP.
{
	order rate_limit before reverse_proxy
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Health check for monitors: no password, and it says nothing but "ok".
	handle /api/ping {
		rewrite * /health
		reverse_proxy gateway:8000
	}

	# The Buyer agent and other services call the gateway here with their own
	# bearer token; the gateway checks it. No shared password on this path.
	handle_path /gateway/* {
		reverse_proxy gateway:8000
	}

	# No password on the screens (Tymon, 2026-11-14): anyone with the link can use
	# the demo, including approving its orders.
	# The gateway's human token is added here, on the server, so it never
	# reaches a browser. The web app says who is acting in X-User.
	handle_path /api/* {
		@anonymous not header X-User *
		request_header @anonymous X-User demo-visitor

		# The path is open, and a new proposal runs the paid Buyer model: cap
		# writes per visitor address. Over the cap the answer is 429.
		rate_limit {
			zone new_proposals {
				match {
					method POST
					path_regexp ^/v1/kitchens/[^/]+/proposals$
				}
				key {remote_host}
				events 10
				window 1m
			}
			zone writes {
				match {
					method POST PUT PATCH DELETE
				}
				key {remote_host}
				events 60
				window 1m
			}
		}
		reverse_proxy gateway:8000 {
			header_up Authorization "Bearer {$GATEWAY_HUMAN_TOKEN}"
		}
	}

	handle {
		root * /srv
		# The web app routes in the browser: unknown paths get index.html.
		try_files {path} /index.html
		file_server
	}
}
