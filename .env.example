VALIO_API_KEY=
VALIO_PORTAL_URL=https://junction26.valioaimo.fi/
VALIO_PORTAL_PASSWORD=
VERDA_API_KEY=
# Nemotron endpoint key used by `python -m agent`
VERDA_INFERENCE_KEY=
NVIDIA_API_KEY=
# MongoDB's embedding API (voyage-4), used for vector search when NVIDIA_API_KEY is empty
MONGODB_AI_API_KEY=
MONGODB_AI_ENDPOINT=
# true = catalog search also uses meaning (Atlas Vector Search); off by default
SEARCH_HYBRID=
CONTEXT_DEV_API_KEY=
CALA_API_KEY=
MONGODB_URI=
GATEWAY_AGENT_TOKEN=
GATEWAY_HUMAN_TOKEN=
GATEWAY_KITCHEN_ID=demo-kitchen
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
GATEWAY_REQUIRE_LOGIN=false
GATEWAY_SIGNING_KEY=
# Explicit Nemotron route; no automatic provider/billing fallback.
NEMOTRON_BASE_URL=
NEMOTRON_MODEL=
# Buyer: one structured product pick by default; loop retains the previous audited mode.
NEMOTRON_BUYER_STRATEGY=single_pick

# Telegram bot of one kitchen (#1330, `python -m bot.app`). TELEGRAM_BOT is the token from BotFather.
# BOT_KITCHEN_TOKEN is a kitchen API token (Settings > API & MCP tokens) with read and propose:
# it never approves. BOT_STT_URL is the internal Whisper service (#1331); empty means no voice.
TELEGRAM_BOT=
BOT_KITCHEN_TOKEN=
BOT_KITCHEN_ID=
BOT_GATEWAY_URL=
BOT_SITE_URL=
BOT_STT_URL=
